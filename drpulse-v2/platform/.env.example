# ── DR Pulse 360 Platform — Environment ────────────────────────────────────
# Copy to .env and fill in real values.

# Platform DB
PLATFORM_DB_HOST=localhost
PLATFORM_DB_PORT=5432
PLATFORM_DB_NAME=srt_platform
PLATFORM_DB_USER=postgres
PLATFORM_DB_PASSWORD=saloniwandile

# Product DB (uses srt_app role so RLS is enforced)
PRODUCT_DB_HOST=localhost
PRODUCT_DB_PORT=5432
PRODUCT_DB_USER=srt_app
PRODUCT_DB_PASSWORD=change_in_production

# Platform API
PLATFORM_PORT=5000
APP_NAME=DR Pulse 360
APP_BASE_URL=http://localhost:3000

# CORS — comma-separated allowed origins
CORS_ORIGINS=http://localhost:3000

# RSA keys (generate with: node scripts/generate-keys.js)
JWT_PRIVATE_KEY_PATH=./keys/private.pem
JWT_PUBLIC_KEY_PATH=./keys/public.pem

# Token TTLs
MASTER_TOKEN_TTL=15m
SCOPED_TOKEN_TTL=60m

# Google OAuth
# Get from: console.cloud.google.com → APIs → Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback

# Microsoft OAuth
# Get from: portal.azure.com → App registrations
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=http://localhost:5000/api/auth/microsoft/callback
MICROSOFT_TENANT_ID=common

# SMTP (for verification + password reset emails)
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=no-reply@drpulse360.com
SMTP_PASS=
SMTP_FROM="DR Pulse 360 <no-reply@drpulse360.com>"
